// Keymap resolution cases with their expected results, written by hand (the oracle). The test in
// src/vectors.rs compiles the tables they name and runs each case through resolve::step.
// Tables: "margin" = data/keymap.jsonc; "user" = margin plus data/keymap-test-user.jsonc.
// Keys are canonical keystrokes for Linux, as ui-egui builds them from key events.
{
  "cases": [
    { "name": "ctrl-= zooms in", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "ctrl-=", "expect": { "kind": "command", "command": "view.zoom.in", "args": null } }] },
    { "name": "ctrl-+ zooms in", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "ctrl-+", "expect": { "kind": "command", "command": "view.zoom.in", "args": null } }] },
    { "name": "ctrl-- zooms out", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "ctrl--", "expect": { "kind": "command", "command": "view.zoom.out", "args": null } }] },
    { "name": "ctrl-1 sets 100 percent", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "ctrl-1", "expect": { "kind": "command", "command": "view.zoom.set", "args": { "percent": 100 } } }] },
    { "name": "a global binding reaches the reader", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "ctrl-k", "expect": { "kind": "command", "command": "view.palette", "args": null } }] },
    { "name": "deeper Find wins over Reader for down", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Find > TextInput",
      "steps": [{ "key": "down", "expect": { "kind": "command", "command": "reader.find.next", "args": null } }] },
    { "name": "down scrolls on the page", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "down", "expect": { "kind": "command", "command": "reader.scroll.down", "args": null } }] },
    { "name": "AnnotateMode letters pick comment tools", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > AnnotateMode tool=comment.highlight > Page",
      "steps": [{ "key": "p", "expect": { "kind": "command", "command": "comment.ink", "args": null } },
                { "key": "v", "expect": { "kind": "command", "command": "reader.tool.select", "args": null } }] },
    { "name": "Selection letters mark the selection", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Page > Selection selection=text",
      "steps": [{ "key": "u", "expect": { "kind": "command", "command": "comment.underline", "args": null } }] },
    { "name": "a tool letter does nothing outside annotate mode", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "p", "expect": { "kind": "none" } }] },
    { "name": "enter in the find field goes to the next match", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Find > TextInput",
      "steps": [{ "key": "enter", "expect": { "kind": "command", "command": "reader.find.next", "args": null } },
                { "key": "shift-enter", "expect": { "kind": "command", "command": "reader.find.prev", "args": null } }] },
    { "name": "TextInput: a printable key never fires", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Find > TextInput",
      "steps": [{ "key": "j", "expect": { "kind": "none" } }, { "key": "?", "expect": { "kind": "none" } }, { "key": "space", "expect": { "kind": "none" } }] },
    { "name": "TextInput: an in_text command still fires", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Find > TextInput",
      "steps": [{ "key": "f3", "expect": { "kind": "command", "command": "reader.find.next", "args": null } },
                { "key": "ctrl-k", "expect": { "kind": "command", "command": "view.palette", "args": null } },
                { "key": "escape", "expect": { "kind": "command", "command": "app.close_layer", "args": null } }] },
    { "name": "TextInput: undo is left to the text field", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Find > TextInput",
      "steps": [{ "key": "ctrl-z", "expect": { "kind": "none" } }] },
    { "name": "the palette input keeps its letters", "table": "margin", "stack": "App os=linux > Palette > TextInput",
      "steps": [{ "key": "j", "expect": { "kind": "none" } },
                { "key": "ctrl-k", "expect": { "kind": "command", "command": "view.palette", "args": null } }] },
    { "name": "slash finds in the reader", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "/", "expect": { "kind": "command", "command": "edit.find", "args": null } }] },
    { "name": "question mark opens the keyboard sheet", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "?", "expect": { "kind": "command", "command": "help.shortcuts", "args": null } }] },
    { "name": "a false when lets the key fall through", "table": "user", "stack": "App os=linux",
      "steps": [{ "key": "x", "expect": { "kind": "none" } }] },
    { "name": "a true when runs the command", "table": "user", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "x", "expect": { "kind": "command", "command": "reader.page.next", "args": null } }] },
    { "name": "reader keys stay off the home screen", "table": "margin", "stack": "App os=linux",
      "steps": [{ "key": "j", "expect": { "kind": "none" } }, { "key": "ctrl-s", "expect": { "kind": "command", "command": "file.save", "args": null } }] },
    { "name": "an unbound key goes to the widgets", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "ctrl-y", "expect": { "kind": "none" } }] },
    { "name": "named keys with modifiers", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "shift-space", "expect": { "kind": "command", "command": "reader.screen.up", "args": null } },
                { "key": "alt-left", "expect": { "kind": "command", "command": "reader.back", "args": null } }] },
    { "name": "g alone without a chord", "table": "margin", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "g", "expect": { "kind": "command", "command": "view.focus_page_input", "args": null } }] },
    { "name": "a user binding without context beats the built-in one", "table": "user", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "ctrl-p", "expect": { "kind": "command", "command": "view.palette", "args": null } }] },
    { "name": "null unbinds a key at the same depth", "table": "user", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "down", "expect": { "kind": "none" } },
                { "key": "shift-j", "expect": { "kind": "command", "command": "reader.page.next", "args": null } }] },
    { "name": "null at Reader does not hide a deeper binding", "table": "user", "stack": "App os=linux > Reader format=pdf layout=scroll > Find > TextInput",
      "steps": [{ "key": "down", "expect": { "kind": "command", "command": "reader.find.next", "args": null } }] },
    { "name": "chord completes", "table": "user", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "g", "expect": { "kind": "pending" } },
                { "key": "g", "expect": { "kind": "command", "command": "reader.page.first", "args": null } }] },
    { "name": "chord timeout runs the shorter binding", "table": "user", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "g", "expect": { "kind": "pending" } },
                { "timeout": true, "expect": { "kind": "command", "command": "view.focus_page_input", "args": null } }] },
    { "name": "a key that breaks the chord is matched alone", "table": "user", "stack": "App os=linux > Reader format=pdf layout=scroll > Page",
      "steps": [{ "key": "g", "expect": { "kind": "pending" } },
                { "key": "j", "expect": { "kind": "command", "command": "reader.scroll.down", "args": null } }] },
    { "name": "TextInput: a printable chord prefix never pends", "table": "user", "stack": "App os=linux > Reader format=pdf layout=scroll > Find > TextInput",
      "steps": [{ "key": "g", "expect": { "kind": "none" } }] }
  ]
}
